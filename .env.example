# Environnement
NODE_ENV=development
PORT=5000
# 0.0.0.0 = accessible depuis le réseau local (ex: test sur téléphone), pas seulement localhost
HOST=0.0.0.0

# Base de données PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/azelie?schema=public"

# JWT (authentification admin)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS — domaines autorisés à appeler l'API, séparés par des virgules
# Ajouter l'IP LAN du PC (ex: http://192.168.1.9:3000) pour tester depuis un téléphone
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# SMTP (Nodemailer) — laisser vide pour simuler l'envoi des emails en dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@azelie.com
MAIL_TO_ADMIN=admin@azelie.com

# Upload de fichiers
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
